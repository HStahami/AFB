# ==============================================================================
# ALARABIA FI BUYUTIKUM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values before starting the application.
# IMPORTANT: NEVER commit real passwords, API secrets, or private keys to Git.
# ==============================================================================

# --- Environment Mode ---
# Options: 'development' (convenient local defaults) or 'production' (strict validation)
ENVIRONMENT=development

# --- MongoDB Atlas Connection (REQUIRED) ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/alarabia_db?retryWrites=true&w=majority
MONGODB_DB_NAME=alarabia_db

# --- Authentication & JWT Security (REQUIRED in production) ---
# In production, must be a cryptographically strong secret of at least 32 characters.
# Generate with: python -c import secrets; print(secrets.token_hex(32))
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_random_string_32chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Initial Admin Account (REQUIRED) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_admin_password

# --- Cloudinary Media Storage (REQUIRED for production media persistence) ---
# Register at https://cloudinary.com to obtain credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP Email Service (REQUIRED for student credential delivery) ---
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=info@example.com
SMTP_PASSWORD=replace_with_smtp_password
EMAIL_FROM=AlArabia Fi Buyutikum <info@example.com>
INSTITUTE_NOTIFICATION_EMAIL=admin@example.com

# --- WhatsApp Admission Alerts (OPTIONAL) ---
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
INSTITUTE_WHATSAPP_NUMBER=

# --- CORS Allowed Origins (Comma-separated, OPTIONAL) ---
# Example: https://alarabiafibuyutikum.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=

# --- Portal URLs (OPTIONAL) ---
STUDENT_PORTAL_URL=/student/login
INSTRUCTOR_PORTAL_URL=/instructor/login
